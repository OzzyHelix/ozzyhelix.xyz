# /etc/nginx/sites-available/ozzyhelix.xyz
# Enable with: sudo ln -s /etc/nginx/sites-available/ozzyhelix.xyz /etc/nginx/sites-enabled/
# Then: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name ozzyhelix.xyz www.ozzyhelix.xyz;

    root /var/www/ozzyhelix.xyz;
    index index.html;

    # Redirect HTTP to HTTPS (run certbot to enable TLS)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ozzyhelix.xyz www.ozzyhelix.xyz;

    # Obtain these with: sudo certbot --nginx -d ozzyhelix.xyz -d www.ozzyhelix.xyz
    ssl_certificate /etc/letsencrypt/live/ozzyhelix.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ozzyhelix.xyz/privkey.pem;

    root /var/www/ozzyhelix.xyz;
    index index.html;

    # Long-lived caching for static assets with hashed-style filenames
    location ~* \.(css|js|svg|woff2?|png|jpg|jpeg|gif|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Never cache the HTML itself
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
