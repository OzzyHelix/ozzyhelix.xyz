# /etc/nginx/sites-available/ozzyhelix.xyz
# Local NAT config for a Debian container — serves the site from /var/www/html.
#
# Apply with:
#   sudo cp nginx.conf.example /etc/nginx/sites-available/ozzyhelix.xyz
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo ln -s /etc/nginx/sites-available/ozzyhelix.xyz /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name _;

    root /var/www/html;
    index index.html;

    # Long-lived caching for static assets
    location ~* \.(css|js|svg|woff2?|png|jpg|jpeg|gif|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Never cache the HTML itself
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # Serve the license inline instead of downloading it
    location = /LICENSE {
        default_type text/plain;
        add_header Content-Disposition "inline";
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
